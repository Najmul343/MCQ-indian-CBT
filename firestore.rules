rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function myRole() {
      return request.auth.token.role != null ? request.auth.token.role : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isSuperAdmin() {
      return isSignedIn() && (myRole() == 'super_admin' || request.auth.token.email == 'thenajmulhuda@gmail.com');
    }

    // Super Admin global override
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // Users collection rules: read/write own profile
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && userId == request.auth.uid;
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (userId == request.auth.uid && request.resource.data.role == resource.data.role)
      );
      allow delete: if isSuperAdmin();
    }

    // Questions: readable by all signed-in students/admins
    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSuperAdmin();
    }

    // Tests: readable by all signed-in students/admins
    match /tests/{testId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSuperAdmin();
    }

    // Test Attempts: students create & read their own attempts; super_admin can manage all
    match /test_attempts/{attemptId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() || resource.data.student_id == request.auth.uid
      );
      allow create: if isSignedIn() && (
        request.resource.data.student_id == request.auth.uid || isSuperAdmin()
      );
      allow update, delete: if isSuperAdmin();
    }
  }
}
